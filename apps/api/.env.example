PORT=4000
MONGO_URL=mongodb://localhost:27017/online-banking
# Required. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGIN=http://localhost:3000
# Optional: Brevo (Sendinblue) API key. Without it, emails are logged instead of sent.
SIB_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Online Banking
# Used by `npm run seed:admin` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
